# Database: lokal SQLite-fil (standard) eller Turso i produktion
DATABASE_URL="file:./data/fixflow.db"
# Kun til Turso (libsql://...)
DATABASE_AUTH_TOKEN=""

# Hemmelig nøgle til login-cookies (mindst 32 tegn). Generér med: openssl rand -base64 32
AUTH_SECRET="skift-mig-til-en-lang-tilfaeldig-hemmelighed-1234567890"

# Claude. Tom = demo-tilstand med eksempel-analyser
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Hvor uploadede filer gemmes: "disk" (UPLOAD_DIR) eller "db" (i databasen – til Render free + Turso).
# Tom = "db" når DATABASE_URL er en fjern database, ellers "disk".
STORAGE_DRIVER=""
UPLOAD_DIR="./data/uploads"

# Stripe. Tom = simuleret betaling (testtilstand)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_SINGLE=""
# 3-pakke (199 kr., one-off). Tom = 3-pakken vises ikke, når Stripe er slået til.
STRIPE_PRICE_PACK3=""
APP_URL="http://localhost:3000"

# Find håndværkere: adgang til CVR-registrets "system-til-system"-søgning (gratis, søg hos Erhvervsstyrelsen).
# Tom = fiktive demo-firmaer.
CVR_ES_USER=""
CVR_ES_PASSWORD=""
# CVR_ES_URL="https://distribution.virk.dk/cvr-permanent/virksomhed/_search"

# Postnumre -> koordinater (afstand). Tom = indbygget tabel med omtrentlige bymidter.
# Kan sættes til en DAWA-kompatibel adresse-API, fx https://api.dataforsyningen.dk (tjek at den stadig udbydes).
GEO_API_URL=""

# Virksomhedsoplysninger til handelsbetingelser, privatlivspolitik og footer (SKAL udfyldes før lancering)
COMPANY_NAME=""
COMPANY_CVR=""
COMPANY_ADDRESS=""
CONTACT_EMAIL=""
COMPANY_PHONE=""
# "0" hides the address in the footer (name, CVR and e-mail stay). The legal pages always show it.
COMPANY_FOOTER_ADDRESS=""

# E-mail (glemt adgangskode, ordrebekræftelser, fortrydelse). Brevo (EU) – gratis op til 300 e-mails/dag.
# Kun nøglen er nødvendig; afsender er noreply@<domænet i APP_URL> (domænet skal verificeres i Brevo én gang).
# Uden nøgle sendes intet, og "Glemt adgangskode" viser i stedet kontakt-e-mailen.
BREVO_API_KEY=""
# Valgfri: anden afsender end noreply@<domæne>
EMAIL_FROM=""

# Partnerkoder: KODE=antal brug[:analyser pr. brug], kommasepareret. Fx "MAEGLERSVB=50,ENERGIODENSE=50:2".
# Synkroniseres ved opstart; en kode, der fjernes herfra, lukkes (tidligere indløsninger bevares).
PARTNER_CODES=""

# Gratis beta: alle får hele analysen, max BETA_ANALYSES pr. person, og der kan ikke købes noget.
BETA_FREE=""
BETA_ANALYSES="5"

# Drift (se README → Drift og robusthed)
AI_DAILY_LIMIT="300"
ANTHROPIC_FALLBACK_MODELS="claude-opus-5-5"
# Kun til lokal test/Docker med volumen:
ALLOW_LOCAL_DB=""
ALLOW_SIMULATED_PAYMENTS=""

# Admin page with anonymous usage counts (/dashboard/admin): comma-separated e-mail addresses.
ADMIN_EMAILS=""
